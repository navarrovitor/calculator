# Copy to docker-compose.override.yml (gitignored, auto-loaded by compose) if
# your network runs a TLS-inspecting proxy (e.g. Zscaler) and the frontend's
# `npm ci` fails cert validation. Point the secret at your CA bundle:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build

services:
  frontend:
    build:
      secrets:
        - ca

secrets:
  ca:
    file: /etc/ssl/certs/ca-certificates.crt
